{
  "name": "orbital-watch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Orbital Watch — a local live 3D satellite tracker and pass planner.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "prestart": "npm run build",
    "start": "node server/server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "compare:iss": "node scripts/compare-iss.mjs"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "^7.1.0"
  }
}
